# Copy to .env and fill in for your environment.

# Base URL of the Spring Boot backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080

# The workspace this frontend operates in, used only as a fallback before
# the signed-in staff user's own workspace (currentUser.workspaceId, from
# GET /feedback/user/me) is known. Workspace ids are UUIDs (not numbers) —
# see docs/backend-api-requirements.md's UUID migration note. No default
# is provided; leave unset unless you have a specific reason to override
# the authenticated user's own workspace.
VITE_WORKSPACE_ID=

# Optional, production only. Your root domain, e.g. "fidmap.co" (this
# project's actual production root domain — NOT "fidmap.com"). When set,
# visiting {workspaceSlug}.<this domain> routes to that workspace's public
# portal (see utils/tenant.js + App.jsx's subdomain branch, which hands
# off to the same /p/:workspaceSlug components used in local dev).
# Requires wildcard DNS (*.fidmap.co) pointed at this app. Leave unset in
# local dev — the portal is always reachable at /p/:workspaceSlug
# regardless of this setting.
VITE_ROOT_DOMAIN=

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX"), for the
# production property at https://fidmap.co. Defaults to the production ID
# below (see utils/analytics.js) so analytics work even without a local
# .env — override here if you ever need a different GA4 property (e.g. a
# separate one for staging).
VITE_GA_MEASUREMENT_ID=G-XTKYDZ2XYK
